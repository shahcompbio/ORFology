nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    // stub run: the default path downloads the UniProt proteome, which is far
    // too slow for CI. The blast_db test covers the pipeline for real.
    test("-profile test -stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
        }
    }
}
